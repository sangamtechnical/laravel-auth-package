{
    "name": "sangamtechnical/laravel-auth-package",
    "description": "Reusable authentication package for Laravel (signup, signin, forgot password)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "auth",
        "authentication",
        "package"
    ],
    "authors": [
        {
            "name": "Sangam Technical",
            "email": "your-email@example.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^10.0",
        "illuminate/auth": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "SangamTechnical\\AuthPackage\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SangamTechnical\\AuthPackage\\AuthServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
